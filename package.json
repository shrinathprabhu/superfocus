{
  "name": "superfocus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run generate:config && vite",
    "build": "npm run generate:config && node scripts/build.mjs cloudflare-module",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "check:http": "node --experimental-strip-types scripts/check-http.mjs",
    "generate:assets": "node scripts/generate-audio.mjs && node scripts/generate-icons.mjs",
    "generate:config": "node --experimental-strip-types scripts/generate-discovery.mjs",
    "build:preview": "npm run generate:config && node scripts/build.mjs node",
    "generate:og": "node scripts/render-social-image.mjs",
    "build:cloudflare": "npm run build",
    "preview:cloudflare": "wrangler dev --port 4319",
    "check:cloudflare": "node --experimental-strip-types scripts/check-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "fake-indexeddb": "^6.2.5",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.156.0"
  },
  "type": "module"
}
